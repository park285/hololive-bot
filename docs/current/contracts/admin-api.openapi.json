  },
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    },
    "schemas": {
      "AddRoomRequest": {
        "type": "object",
        "required": [
          "room",
          "mode"
        ],
        "properties": {
          "room": {
            "type": "string",
            "pattern": "^(0|-?[1-9][0-9]{0,18})$",
            "description": "canonical signed 64-bit chat ID"
          },
          "mode": {
            "type": "string",
            "enum": [
              "whitelist",
              "blacklist"
            ],
            "description": "호출자가 읽은 ACL 모드. 현재 모드와 다르면 409 acl_mode_changed"
          }
        },
        "description": "알 수 없는 필드는 무시합니다."
      },
      "JoinedRoom": {
        "type": "object",
        "required": [
          "chatId",
          "name",
          "type",
          "memberCount"
        ],
        "properties": {
          "chatId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "memberCount": {
            "type": "integer"
          }
        },
        "additionalProperties": false
      },
      "JoinedRoomsResponse": {
        "type": "object",
        "required": [
          "status",
          "rooms"
        ],
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          },
          "rooms": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/JoinedRoom"
            }
          }
        },
        "additionalProperties": false
      },
      "ProducerError": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        }
      },
      "RemoveRoomRequest": {
        "type": "object",
        "required": [
          "room",
          "mode"
        ],
        "properties": {
          "room": {
            "type": "string",
            "pattern": "^(0|-?[1-9][0-9]{0,18})$",
            "description": "canonical signed 64-bit chat ID"
          },
          "mode": {
            "type": "string",
            "enum": [
              "whitelist",
              "blacklist"
            ],
            "description": "호출자가 읽은 ACL 모드. 현재 모드와 다르면 409 acl_mode_changed"
          }
        },
        "description": "알 수 없는 필드는 무시합니다."
      },
      "RoomChangeResponse": {
        "type": "object",
        "required": [
          "status",
          "message",
          "changed"
        ],
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          },
          "message": {
            "type": "string"
          },
          "changed": {
            "type": "boolean",
            "description": "false면 이미 요청한 상태였고 쓰지 않았음"
          }
        },
        "additionalProperties": false
      },
      "RoomsResponse": {
        "type": "object",
        "required": [
          "status",
          "rooms",
          "aclEnabled",
          "aclMode"
        ],
        "properties": {
          "aclEnabled": {
            "type": "boolean"
          },
          "aclMode": {
            "type": "string",
            "enum": [
              "whitelist",
              "blacklist"
            ]
          },
          "rooms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string",
            "const": "ok"
          }
        },
        "additionalProperties": false,
        "description": "rooms는 페이지 없이 현재 모드 목록 전체입니다. 생산자는 상한을 두지 않으며 표시 상한은 소비자가 소유합니다."
      },
      "SetAclRequest": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "mode": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "whitelist",
              "blacklist",
              null
            ]
          }
        },
        "description": "enabled·mode 가운데 하나 이상은 null이 아니어야 합니다(둘 다 없거나 null이면 400). 알 수 없는 필드는 무시합니다."
      },
      "SetAclResponse": {
        "type": "object",
        "required": [
          "status",
          "message",
          "enabled",
          "mode"
        ],
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          },
          "message": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "mode": {
            "type": "string",
            "enum": [
              "whitelist",
              "blacklist"
            ]
          }
        },
        "additionalProperties": false
      },
      "ConfirmSchedulePosterRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "expectedRevision",
          "weekStart",
          "weekEnd"
        ],
        "properties": {
          "expectedRevision": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,18}$"
          },
          "weekStart": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "weekEnd": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          }
        },
        "description": "주 범위는 7일 이하이고 게시일(JST)과 7일 이내여야 하며, 어기면 409 code=invalid_week입니다."
      },
      "UpdateSchedulePosterWeekRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "expectedRevision",
          "weekStart",
          "weekEnd"
        ],
        "properties": {
          "expectedRevision": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,18}$"
          },
          "weekStart": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "weekEnd": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          }
        },
        "description": "확정본의 주 범위만 고치며 다시 번역하지 않습니다. 확정과 같이 7일 이하이고 게시일(JST)과 7일 이내여야 하며 어기면 409 code=invalid_week입니다. 확정본이 아니거나 번역 대기 중(진행 중인 번역 결과를 버리지 않기 위해)이면 409 code=invalid_state입니다."
      },
      "SchedulePoster": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "channelId",
          "postUrl",
          "imageUrl",
          "postedAt",
          "textExcerpt",
          "reviewStatus",
          "weekStart",
          "weekEnd",
          "reviewedAt",
          "reviewedBy",
          "reviewRequestReason",
          "translationStatus",
          "translationError",
          "translatedAt",
          "revision",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/SchedulePosterId"
          },
          "channelId": {
            "type": "string",
            "minLength": 1
          },
          "postUrl": {
            "type": "string",
            "pattern": "^https://(x\\.com/i/status/[1-9][0-9]*|www\\.youtube\\.com/post/[A-Za-z0-9_-]+|www\\.youtube\\.com/watch\\?v=[A-Za-z0-9_-]{11})$"
          },
          "imageUrl": {
            "type": "string",
            "pattern": "^https://(pbs\\.twimg\\.com|yt3\\.ggpht\\.com|i\\.ytimg\\.com)/"
          },
          "postedAt": {
            "type": "string",
            "minLength": 1
          },
          "textExcerpt": {
            "type": "string",
            "maxLength": 500
          },
          "reviewStatus": {
            "$ref": "#/components/schemas/SchedulePosterReviewStatus"
          },
          "weekStart": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "weekEnd": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "reviewedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "reviewedBy": {
            "type": "string",
            "enum": [
              "",
              "auto",
              "admin"
            ],
            "description": "확정·거절을 누가 했는지입니다. auto는 관리자 검토로 넘기기 전에 자동 검토가 정한 것이고, 검토 대기·만료이거나 알 수 없으면 빈 문자열입니다."
          },
          "reviewRequestReason": {
            "type": "string",
            "enum": [
              "",
              "uncertain",
              "unjudgeable",
              "image_changed",
              "period_unread",
              "week_rejected",
              "week_overlapping",
              "stale",
              "auto_review_off"
            ],
            "description": "자동 검토가 후보를 관리자 검토로 넘긴 이유입니다. uncertain(일정표·한 주·한 명 판정 중 하나가 불확실), unjudgeable(모델이 판정할 수 없는 그림), image_changed(수집 뒤 그림이 바뀜), period_unread(인쇄된 기간을 게시 주나 다음 주로 맞추지 못함), week_rejected(읽은 주가 게시일과 맞지 않음), week_overlapping(같은 멤버의 확정본과 주가 겹침), stale(6시간 안에 판정하지 못함), auto_review_off(자동 검토를 끈 뒤 남은 후보). 자동 검토 없이 들어왔으면 빈 문자열입니다."
          },
          "translationStatus": {
            "type": "string",
            "enum": [
              "not_requested",
              "pending",
              "succeeded",
              "failed"
            ]
          },
