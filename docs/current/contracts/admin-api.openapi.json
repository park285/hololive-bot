{
  "openapi": "3.1.0",
  "info": {
    "title": "hololive-api admin plane",
    "version": "1",
    "description": "hololive-api admin plane `/api/holo/*` 생산자 계약입니다. 이 파일에는 생산자 시험이 실제 handler 요청·응답으로 검증한 operation만 둡니다. 계약 문서: docs/current/contracts/admin-api.md"
  },
  "security": [
    {
      "apiKey": []
    }
  ],
  "paths": {
    "/api/holo/rooms": {
      "get": {
        "operationId": "holoGetRooms",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RoomsResponse"
                }
              }
            }
          },
          "default": {
            "description": "Producer error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProducerError"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "holoAddRoom",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddRoomRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RoomChangeResponse"
                }
              }
            }
          },
          "default": {
            "description": "Producer error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProducerError"
                }
              }
            }
          },
          "409": {
            "description": "ACL mode changed (code acl_mode_changed); nothing written",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProducerError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "holoRemoveRoom",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RemoveRoomRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RoomChangeResponse"
                }
              }
            }
          },
          "default": {
            "description": "Producer error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProducerError"
                }
              }
            }
          },
          "409": {
            "description": "ACL mode changed (code acl_mode_changed); nothing written",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProducerError"
                }
              }
            }
          }
        }
      }
    },
    "/api/holo/rooms/joined": {
      "get": {
        "operationId": "holoGetRoomsJoined",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JoinedRoomsResponse"
                }
              }
            }
          },
          "default": {
            "description": "Producer error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProducerError"
                }
              }
            }
          }
        }
      }
    },
    "/api/holo/rooms/acl": {
      "post": {
        "operationId": "holoSetAcl",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetAclRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SetAclResponse"
                }
              }
            }
          },
          "default": {
            "description": "Producer error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProducerError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    },
    "schemas": {
      "AddRoomRequest": {
        "type": "object",
        "required": [
          "room",
          "mode"
        ],
        "properties": {
          "room": {
            "type": "string",
            "pattern": "^(0|-?[1-9][0-9]{0,18})$",
            "description": "canonical signed 64-bit chat ID"
          },
          "mode": {
            "type": "string",
            "enum": [
              "whitelist",
              "blacklist"
            ],
            "description": "호출자가 읽은 ACL 모드. 현재 모드와 다르면 409 acl_mode_changed"
          }
        },
        "description": "알 수 없는 필드는 무시합니다."
      },
      "JoinedRoom": {
        "type": "object",
        "required": [
          "chatId",
          "name",
          "type",
          "memberCount"
        ],
        "properties": {
          "chatId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "memberCount": {
            "type": "integer"
          }
        },
        "additionalProperties": false
      },
      "JoinedRoomsResponse": {
        "type": "object",
        "required": [
          "status",
          "rooms"
        ],
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          },
          "rooms": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/JoinedRoom"
            }
          }
        },
        "additionalProperties": false
      },
      "ProducerError": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        }
      },
      "RemoveRoomRequest": {
        "type": "object",
        "required": [
          "room",
          "mode"
        ],
        "properties": {
          "room": {
            "type": "string",
            "pattern": "^(0|-?[1-9][0-9]{0,18})$",
            "description": "canonical signed 64-bit chat ID"
          },
          "mode": {
            "type": "string",
            "enum": [
              "whitelist",
              "blacklist"
            ],
            "description": "호출자가 읽은 ACL 모드. 현재 모드와 다르면 409 acl_mode_changed"
          }
        },
        "description": "알 수 없는 필드는 무시합니다."
      },
      "RoomChangeResponse": {
        "type": "object",
        "required": [
          "status",
          "message",
          "changed"
        ],
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          },
          "message": {
            "type": "string"
          },
          "changed": {
            "type": "boolean",
            "description": "false면 이미 요청한 상태였고 쓰지 않았음"
          }
        },
        "additionalProperties": false
      },
      "RoomsResponse": {
        "type": "object",
        "required": [
          "status",
          "rooms",
          "aclEnabled",
          "aclMode"
        ],
        "properties": {
          "aclEnabled": {
            "type": "boolean"
          },
          "aclMode": {
            "type": "string",
            "enum": [
              "whitelist",
              "blacklist"
            ]
          },
          "rooms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string",
            "const": "ok"
          }
        },
        "additionalProperties": false,
        "description": "rooms는 페이지 없이 현재 모드 목록 전체입니다. 생산자는 상한을 두지 않으며 표시 상한은 소비자가 소유합니다."
      },
      "SetAclRequest": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "mode": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "whitelist",
              "blacklist",
              null
            ]
          }
        },
        "description": "enabled·mode 가운데 하나 이상은 null이 아니어야 합니다(둘 다 없거나 null이면 400). 알 수 없는 필드는 무시합니다."
      },
      "SetAclResponse": {
        "type": "object",
        "required": [
          "status",
          "message",
          "enabled",
          "mode"
        ],
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          },
          "message": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "mode": {
            "type": "string",
            "enum": [
              "whitelist",
              "blacklist"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  }
}
