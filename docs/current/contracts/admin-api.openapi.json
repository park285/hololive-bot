{
  "openapi": "3.1.0",
  "info": {
    "title": "hololive-api admin plane",
    "version": "1",
    "description": "hololive-api admin plane `/api/holo/*` 생산자 계약입니다. 이 파일에는 생산자 시험이 실제 handler 요청·응답으로 검증한 operation만 둡니다. 계약 문서: docs/current/contracts/admin-api.md"
  },
  "security": [
    {
      "apiKey": []
    }
  ],
  "paths": {
    "/api/holo/rooms": {
      "get": {
        "operationId": "holoGetRooms",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RoomsResponse"
                }
              }
            }
          },
          "default": {
            "description": "Producer error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProducerError"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "holoAddRoom",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddRoomRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RoomChangeResponse"
                }
              }
            }
          },
          "default": {
            "description": "Producer error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProducerError"
                }
              }
            }
          },
          "409": {
            "description": "ACL mode changed (code acl_mode_changed); nothing written",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProducerError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "holoRemoveRoom",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RemoveRoomRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RoomChangeResponse"
                }
              }
            }
          },
          "default": {
            "description": "Producer error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProducerError"
                }
              }
            }
          },
          "409": {
            "description": "ACL mode changed (code acl_mode_changed); nothing written",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProducerError"
                }
              }
            }
          }
        }
      }
    },
