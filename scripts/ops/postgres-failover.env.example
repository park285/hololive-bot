# /etc/stack-secrets/hololive-bot/postgres-failover.env
# root:root 0600. launcher는 허용된 KEY=VALUE만 읽으며 셸 확장은 하지 않습니다.

POSTGRES_FAILOVER_PRIMARY_HOST=100.100.1.8
POSTGRES_FAILOVER_PRIMARY_PORT=5433
POSTGRES_FAILOVER_NEW_PRIMARY_HOST=100.100.1.5
POSTGRES_FAILOVER_NEW_PRIMARY_PORT=5434
POSTGRES_FAILOVER_LOCAL_HOST=100.100.1.5
POSTGRES_FAILOVER_LOCAL_PORT=5434
POSTGRES_FAILOVER_PROBE_USER=hololive_replicator
POSTGRES_FAILOVER_FAILURE_THRESHOLD=4
POSTGRES_FAILOVER_MIN_OUTAGE_SEC=45
POSTGRES_FAILOVER_MAX_LAST_HEALTHY_AGE_SEC=120
# 비동기 복제 승격은 최근 표본의 지연이 0일 때만 허용합니다. 상한 증가는 데이터 유실 위험 승인이 필요합니다.
POSTGRES_FAILOVER_MAX_KNOWN_LAG_BYTES=0
POSTGRES_FAILOVER_REQUIRE_ROUTE_HOOK=1
POSTGRES_FAILOVER_PROBE_TIMEOUT_SEC=3
POSTGRES_FAILOVER_PROMOTE_TIMEOUT_SEC=60
POSTGRES_FAILOVER_FENCE_HOOK_TIMEOUT_SEC=180
POSTGRES_FAILOVER_ROUTE_HOOK_TIMEOUT_SEC=90

# hook·상위 경로는 정규 경로, root 소유이며 group·other 쓰기가 금지됩니다. stdout은 아래 승인 형식만 허용합니다.
POSTGRES_FAILOVER_FENCE_COMMAND=/usr/local/libexec/hololive-postgres-failover/postgres-failover-fence-ssh.sh
POSTGRES_FAILOVER_ROUTE_COMMAND=/usr/local/libexec/hololive-postgres-failover/postgres-failover-route-ssh.sh

# SSH fencing은 구 primary에 접속할 수 있을 때만 유효합니다. 호스트·전원 장애는 별도 외부 fencing hook이 필요합니다.
POSTGRES_FAILOVER_SSH_TARGET=hololive-pg-fence@100.100.1.8
# SSH 키·known_hosts는 apply drop-in의 systemd LoadCredential로만 제공합니다.
POSTGRES_FAILOVER_SSH_HOST_KEY_ALIAS=100.100.1.8
POSTGRES_FAILOVER_SSH_CONNECT_TIMEOUT_SEC=5
POSTGRES_FAILOVER_REMOTE_FENCE_SCRIPT=/usr/local/libexec/hololive-postgres-failover/postgres-primary-fence.sh

# route SSH는 fencing과 분리합니다. route helper의 Tailscale Service ID는 fence generation과 같아야 합니다.
POSTGRES_FAILOVER_ROUTE_SSH_TARGET=hololive-pg-route@100.100.1.5
POSTGRES_FAILOVER_ROUTE_SSH_HOST_KEY_ALIAS=100.100.1.5
POSTGRES_FAILOVER_ROUTE_SSH_CONNECT_TIMEOUT_SEC=5
POSTGRES_FAILOVER_ROUTE_REMOTE_SCRIPT=/usr/local/libexec/hololive-postgres-failover/postgres-route-tailscale.sh
# 고정된 원격 helper가 route 대상에서 해석하는 경로입니다.
POSTGRES_FAILOVER_ROUTE_CONFIG_FILE=/etc/hololive-postgres-failover/route.env
POSTGRES_FAILOVER_TAILSCALE_SERVICE=svc:hololive-postgres

# Fence hook 출력:
#   FENCED|<old-primary-host>|<new-primary-host>:<new-primary-port>|<request-id>|<fence-token>
#
# Route hook 계약:
#   입력 환경: POSTGRES_FAILOVER_{OLD,NEW}_PRIMARY_{HOST,PORT},
#              POSTGRES_FAILOVER_FENCE_TOKEN
#   출력: ROUTED|<new-primary-host>:<new-primary-port>|<POSTGRES_FAILOVER_FENCE_TOKEN>
