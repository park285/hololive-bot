[Unit]
Description=hololive-bot Docker Compose stack
After=docker.service tailscaled.service network-online.target
Requires=docker.service
Wants=network-online.target
# The remote fence writes intent before stopping the stack. Either marker blocks
# an old primary from coming back as a writer after a crash or reboot.
ConditionPathExists=!/var/lib/hololive-postgres-fence/fence.intent
ConditionPathExists=!/var/lib/hololive-postgres-fence/fenced

[Service]
Type=oneshot
WorkingDirectory=/opt/hololive-bot/compose/current
ExecStart=/usr/local/sbin/hololive-compose-up
ExecStop=/usr/local/sbin/hololive-compose-down
RemainAfterExit=yes
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
