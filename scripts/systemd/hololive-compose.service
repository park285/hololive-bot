[Unit]
Description=hololive-bot Docker Compose stack
After=docker.service tailscaled.service network-online.target admin-dashboard-ingress-firewall.service
Requires=docker.service admin-dashboard-ingress-firewall.service
Wants=network-online.target
# 원격 격리는 중지 전에 의도를 기록한다. 어느 표식이든 남으면
# 장애·재부팅 뒤 이전 주 서버가 쓰기 서버로 돌아오지 못한다.
ConditionPathExists=!/var/lib/hololive-postgres-fence/fence.intent
ConditionPathExists=!/var/lib/hololive-postgres-fence/fenced

[Service]
Type=oneshot
WorkingDirectory=/opt/hololive-bot/compose/current
ExecStart=/usr/local/sbin/hololive-compose-up
ExecStop=/usr/local/sbin/hololive-compose-down
RemainAfterExit=yes
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
