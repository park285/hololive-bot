[Unit]
Description=Hololive collector AP (%i)
After=network-online.target
Wants=network-online.target
Wants=hololive-youtube-po.service
After=hololive-youtube-po.service

[Service]
Type=simple
User=hololive
Group=opc
WorkingDirectory=/opt/hololive-bot/collector/current
EnvironmentFile=/etc/stack-secrets/hololive-bot/collector.env
EnvironmentFile=/etc/hololive-bot/collector-host.env
ExecStart=/opt/hololive-bot/collector/current/bin/hololive-collector-wrapper /opt/hololive-bot/collector/current/bin/hololive-collector --startup-timeout 90s --wait-for-database
Restart=always
RestartSec=5s
TimeoutStopSec=30s
MemoryMax=768M
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/log/hololive-bot /tmp
ReadWritePaths=/var/lib/hololive-bot

[Install]
WantedBy=multi-user.target
