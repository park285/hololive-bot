[Unit]
Description=Hololive youtube-collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hololive
Group=opc
WorkingDirectory=/opt/hololive-bot/youtube-collector/current
EnvironmentFile=-/etc/stack-secrets/hololive-bot/compose.env
EnvironmentFile=-/etc/stack-secrets/hololive-bot/youtube-collector.env
Environment=YOUTUBE_COLLECTOR_RUNTIME_ALLOWED=true
Environment=YOUTUBE_PRODUCER_RUNTIME_ALLOWED=false
Environment=YOUTUBE_PRODUCER_ACTIVE_ACTIVE_ENABLED=false
Environment=YOUTUBE_INGESTION_ENABLED=true
Environment=PHOTO_SYNC_ENABLED=false
Environment=YOUTUBEJS_SCRIPT=/opt/hololive-bot/youtube-collector/current/youtubejs/src/server.mjs
Environment=POSTGRES_USER=hololive_scraper
Environment=SERVER_PORT=30045
Environment=HOLOLIVE_H3_ADDR=:30045
Environment=HOLOLIVE_METRICS_ADDR=:30096
ExecStart=/opt/hololive-bot/youtube-collector/current/bin/youtube-collector
Restart=always
RestartSec=5s
TimeoutStopSec=30s
MemoryMax=768M
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/log/hololive-bot /tmp
ReadWritePaths=/var/lib/hololive-bot

[Install]
WantedBy=multi-user.target
