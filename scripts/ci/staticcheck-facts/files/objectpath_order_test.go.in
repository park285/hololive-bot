//go:build go1.27

package objectpath_test

import (
	"go/types"
	"os"
	"path/filepath"
	"testing"

	"golang.org/x/tools/go/packages"
	"golang.org/x/tools/go/types/objectpath"
)

// Go 1.27 export data groups generic methods after ordinary methods. Facts must
// still name the same method, parameter, result and nested field across loaders.
func TestStackGenericMethodSourceExportIdentity(t *testing.T) {
	dir := t.TempDir()
	files := map[string]string{
		"go.mod": "module example.com/methodfacts\n\ngo 1.27.1\n",
		"model/model.go": `package model

type Client struct{}
func (Client) Before() {}
func (Client) generic[T any](value T) T { return value }
func (Client) Retired(oldInput struct { OldField string }) (oldOutput struct { OldResult int }) { return }
func (c Client) Healthy(newInput struct { NewField bool }) (newOutput struct { NewResult bool }) {
 newOutput.NewResult = c.generic(newInput.NewField)
 return
}
func (Client) tail[U any](tailInput U) U { return tailInput }
`,
		"consumer/consumer.go": `package consumer
import "example.com/methodfacts/model"
var Client model.Client
`,
	}
	for name, content := range files {
		path := filepath.Join(dir, name)
		if err := os.MkdirAll(filepath.Dir(path), 0o700); err != nil {
			t.Fatal(err)
		}
		if err := os.WriteFile(path, []byte(content), 0o600); err != nil {
			t.Fatal(err)
		}
	}
	load := func(pattern string) *packages.Package {
		t.Helper()
		pkgs, err := packages.Load(&packages.Config{
			Dir:  dir,
			Mode: packages.NeedName | packages.NeedTypes | packages.NeedTypesInfo | packages.NeedSyntax | packages.NeedImports,
			Env:  append(os.Environ(), "GOWORK=off", "GOFLAGS=-mod=readonly"),
		}, pattern)
		if err != nil {
			t.Fatal(err)
		}
		if packages.PrintErrors(pkgs) != 0 || len(pkgs) != 1 {
			t.Fatal("fixture package load failed")
		}
		return pkgs[0]
	}
	source := load("./model").Types
	consumer := load("./consumer")
	imported := consumer.Imports["example.com/methodfacts/model"].Types

	for _, pair := range [][2]*types.Package{{source, imported}, {imported, source}} {
		named := pair[0].Scope().Lookup("Client").Type().(*types.Named)
		for i := range named.NumMethods() {
			method := named.Method(i)
			objects := []types.Object{method}
			sig := method.Type().(*types.Signature)
			for _, tuple := range []*types.Tuple{sig.Params(), sig.Results()} {
				for j := range tuple.Len() {
					variable := tuple.At(j)
					objects = append(objects, variable)
					if structure, ok := variable.Type().(*types.Struct); ok {
						for k := range structure.NumFields() {
							objects = append(objects, structure.Field(k))
						}
					}
				}
			}
			for _, object := range objects {
				path, err := objectpath.For(object)
				if err != nil {
					t.Errorf("encode %s: %v", object, err)
					continue
				}
				decoded, err := objectpath.Object(pair[1], path)
				if err != nil {
					t.Errorf("decode %s for %s: %v", path, object, err)
					continue
				}
				if got, want := decoded.String(), object.String(); got != want {
					t.Errorf("%s changes object identity: got %s; want %s", path, got, want)
				}
			}
		}
	}
}
