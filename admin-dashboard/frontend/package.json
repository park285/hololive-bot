{
  "name": "admin-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@12.0.1+sha512.2f94fd8bf600416416a934bfc59c4991e8bff7372ef7d842784e2a8b8d48c81555ee645069ddea73625fb8e92dc261feab0188fd5dab6c22fefd46316f5f9140",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "^12.0.1",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "node ./node_modules/@typescript/native/bin/tsc -b && vite build",
    "lint": "eslint .",
    "tsc": "node ./node_modules/@typescript/native/bin/tsc",
    "typecheck": "node ./node_modules/@typescript/native/bin/tsc -p tsconfig.app.json --noEmit",
    "test": "tsx --tsconfig tsconfig.app.json --test 'src/**/*.test.ts' 'src/**/*.test.mjs'",
    "preview": "vite preview",
    "generate:api": "mkdir -p ../backend/docs && (cd ../backend && go run ./cmd/export-openapi > docs/swagger.json) && swagger-typescript-api generate -p ../backend/docs/swagger.json -o src/api/generated --axios --modular"
  },
  "overrides": {
    "form-data": "^4.0.6",
    "dompurify": "^3.4.13",
    "esbuild": "^0.28.1",
    "flatted": "^3.4.2",
    "defu": "^6.1.7",
    "yaml": "^2.8.3",
    "follow-redirects": "^1.16.0",
    "postcss": {
      "nanoid": "3.3.18"
    },
    "oas-resolver": {
      "yaml": "1.10.3"
    },
    "oas-linter": {
      "yaml": "1.10.3"
    },
    "oas-validator": {
      "yaml": "1.10.3"
    },
    "swagger2openapi": {
      "yaml": "1.10.3"
    }
  },
  "dependencies": {
    "@fontsource-variable/outfit": "^5.2.8",
    "@fontsource-variable/plus-jakarta-sans": "^5.2.8",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-virtual": "^3.14.9",
    "axios": "^1.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.3.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.101.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.0.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "msw": "^2.15.0",
    "swagger-typescript-api": "^13.12.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
