{
  "name": "admin-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@12.0.2+sha512.b885e890b9418fa1693544d05f53e64f9a73ec194837d4258b15fecdd692347b1dd2a517b1b0cbaf9d31cd8e92c3b70956bd2ecc72833a57b4b3098f5bfa7943",
  "engines": {
    "node": "^24.20.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "^12.0.2",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "node ./node_modules/@typescript/native/bin/tsc -b && vite build",
    "lint": "eslint .",
    "tsc": "node ./node_modules/@typescript/native/bin/tsc",
    "typecheck": "node ./node_modules/@typescript/native/bin/tsc -p tsconfig.app.json --noEmit",
    "test": "tsx --tsconfig tsconfig.app.json --test 'src/**/*.test.ts' 'src/**/*.test.mjs'",
    "preview": "vite preview",
    "generate:api": "mkdir -p ../backend/docs && (cd ../backend && go run ./cmd/export-openapi > docs/swagger.json) && swagger-typescript-api generate -p ../backend/docs/swagger.json -o src/api/generated --axios --modular"
  },
  "overrides": {
    "form-data": "^4.0.6",
    "dompurify": "^3.4.14",
    "esbuild": "^0.28.2",
    "flatted": "^3.4.4",
    "defu": "^6.1.7",
    "yaml": "^2.8.3",
    "follow-redirects": "^1.16.0",
    "postcss": {
      "nanoid": "3.3.18"
    },
    "oas-resolver": {
      "yaml": "1.10.3"
    },
    "oas-linter": {
      "yaml": "1.10.3"
    },
    "oas-validator": {
      "yaml": "1.10.3"
    },
    "swagger2openapi": {
      "yaml": "1.10.3"
    }
  },
  "dependencies": {
    "@fontsource-variable/outfit": "^5.3.0",
