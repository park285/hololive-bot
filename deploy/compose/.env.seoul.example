COMPOSE_ENV_FILE=./.env.seoul
# 주 서버 주소의 정본은 deploy/topology/hosts.conf의 central이다.
HOLOLIVE_CENTRAL_POSTGRES_HOST=100.100.1.8
HOLOLIVE_CENTRAL_POSTGRES_PORT=5433
HOLOLIVE_SCRAPER_PASSWORD=replace_with_dedicated_scraper_password
POSTGRES_SSLMODE=verify-full
# 이 AP에 관리자·런타임·캐시 비밀번호나 대기 서버 활성화를 두지 않는다.
