COMPOSE_ENV_FILE=./.env.seoul
HOLOLIVE_CENTRAL_POSTGRES_HOST=hololive-postgres.tail742dd8.ts.net
HOLOLIVE_CENTRAL_POSTGRES_PORT=5433
# Standby DB는 기본 loopback입니다. failover route를 승인한 뒤에만 이 값을
# iris-seoul tailnet 주소로 바꾸고 source firewall을 제한합니다.
HOLOLIVE_STANDBY_POSTGRES_BIND_IP=127.0.0.1
HOLOLIVE_STANDBY_POSTGRES_PORT=5434
# CACHE_PASSWORD는 production Compose의 공용 valkey-cache에 적용합니다.
# collector overlay는 CACHE_HOST·HOLOLIVE_CENTRAL_CACHE_HOST를 사용하지 않습니다.
CACHE_PASSWORD=change_me_same_as_central_cache_password
CLIPROXY_BASE_URL=http://100.100.1.3:8787/v1
POSTGRES_SOCKET_PATH=
