COMPOSE_ENV_FILE=./.env.osaka
# Compose validation reference; the actual a/d runtime is native.
# Primary address is owned by deploy/topology/hosts.conf (central).
HOLOLIVE_CENTRAL_POSTGRES_HOST=100.100.1.8
HOLOLIVE_CENTRAL_POSTGRES_PORT=5433
HOLOLIVE_SCRAPER_PASSWORD=replace_with_dedicated_scraper_password
POSTGRES_SSLMODE=verify-full
# No admin/runtime/cache password belongs on this AP.
