# bot/admin/llm plane을 한 process로 실행한다.
# alarm-worker를 Wants로 끌어오므로 이 unit을 시작하면 worker도 함께 시작된다.
[Unit]
Description=Hololive API (bot/admin/llm planes)
# 런타임 peer는 Wants=로만 끌어온다. Requires=는 명시적 stop/restart를 전파해 primary fence(소비자 유지)와
# Sentinel HA(로컬 노드 교체)를 깨뜨린다. 방화벽은 보안 전제라 Requires=로 둔다.
Wants=holo-postgres.service valkey-cache.service hololive-alarm-worker.service
Requires=admin-dashboard-ingress-firewall.service
After=holo-postgres.service valkey-cache.service hololive-alarm-worker.service admin-dashboard-ingress-firewall.service tailscaled.service
ConditionPathExists=!/var/lib/hololive-postgres-fence/fence.intent
ConditionPathExists=!/var/lib/hololive-postgres-fence/fenced
StartLimitIntervalSec=0

[Container]
ContainerName=hololive-api
Image=${HOLOLIVE_API_IMAGE}
Pull=never
User=1000
Group=1000
GroupAdd=${HOLOLIVE_RUNTIME_GID}
GroupAdd=1000
# 호스트 ID와 분리한다(크기는 스택 공통 65536). 그룹 비밀은 :idmap 대신 GID를 그대로 매핑해 읽는다(worker-profile-pair.py가 profile mount 줄을 비교).
UserNS=auto:size=65536,gidmapping=${HOLOLIVE_RUNTIME_GID}:${HOLOLIVE_RUNTIME_GID}:1
Network=hololive-net.network
PublishPort=${HOLOLIVE_API_PORT_BIND_IP}:30001:30001
PublishPort=${HOLOLIVE_API_PORT_BIND_IP}:30001:30001/udp
PublishPort=127.0.0.1:30101:30101
PublishPort=127.0.0.1:30006:30006
PublishPort=127.0.0.1:30006:30006/udp
# 승인된 관리 gateway(iris-seoul)용 H3 publish다. source 제한은 admin-dashboard-ingress.nft가 맡는다.
PublishPort=${HOLOLIVE_ADMIN_API_PORT_BIND_IP}:30006:30006/udp
PublishPort=${HOLOLIVE_METRICS_PORT_BIND_IP}:30091:30091
PublishPort=127.0.0.1:30061:30061
DNS=${TAILSCALE_DNS_RESOLVER}
DNS=8.8.8.8
DNS=1.1.1.1
AddHost=host.docker.internal:host-gateway
AddHost=vnic-kapu-iris-seoul-fk:100.100.1.5
AddHost=vnic-kapu-iris-seoul-fk.tail742dd8.ts.net:100.100.1.5
Volume=/opt/hololive-bot/compose/current/data:/app/data:idmap
Volume=${LIVE_LOGS_PATH}:/app/logs:idmap
# IRIS_BASE_URL_FILE은 소유자가 root이거나 실행 uid여야 한다. idmap이 없으면 root 소유 파일이 overflow uid(65534)로 보여 기동하지 못한다.
Volume=/opt/hololive-bot/compose/current/runtime-config:/app/runtime-config:ro,idmap
Volume=/etc/stack-secrets/hololive-bot/certs/hololive-h3.crt:/run/hololive-bot/certs/hololive-h3.crt:ro
Volume=/etc/stack-secrets/hololive-bot/certs/hololive-h3.key:/run/hololive-bot/certs/hololive-h3.key:ro
Volume=/etc/stack-secrets/hololive-bot/certs/iris-ca.pem:/run/hololive-bot/certs/iris-ca.pem:ro
Volume=/etc/stack-secrets/hololive-bot/certs/postgres-ca.pem:/run/hololive-bot/certs/postgres-ca.pem:ro
Volume=/etc/stack-secrets/hololive-bot/certs/valkey-api-password:/run/hololive-bot/certs/valkey-api-password:ro
Volume=/etc/stack-secrets/hololive-bot/certs/valkey-discovery-password:/run/hololive-bot/certs/valkey-discovery-password:ro
# 원자 교체가 drift 감시에 보이도록 profile은 디렉터리로 mount한다.
Volume=/etc/stack-secrets/hololive-bot/worker-profiles:/run/hololive-bot/worker-profiles:ro
Tmpfs=/tmp:size=64m,mode=1777,noexec,nosuid,nodev
ReadOnly=true
ReadOnlyTmpfs=false
NoNewPrivileges=true
DropCapability=all
# 2026-11-06 hololive-seoul 실측: 30일 최대 RSS 308MiB, 컨테이너 working set 최대 216MiB(7일).
# 2.5배 여유를 둔 768m로 줄여 호스트(11.65GiB)의 컨테이너 한도 합계 여유를 늘린다. GOMEMLIMIT은 한도의 약 80%다.
Memory=768m
PidsLimit=512
StopTimeout=45
LogDriver=journald
EnvironmentFile=/etc/stack-secrets/hololive-bot/bot.env
Environment=LLM_PROVIDER=${LLM_PROVIDER}
Environment=CLIPROXY_ENABLED=true
Environment=CLIPROXY_BASE_URL=${CLIPROXY_BASE_URL}
Environment=CLIPROXY_MODEL=${CLIPROXY_MODEL}
Environment=CLIPROXY_REASONING_EFFORT=${CLIPROXY_REASONING_EFFORT}
Environment=GEMINI_ENABLED=${GEMINI_ENABLED}
Environment=GEMINI_BASE_URL=${GEMINI_BASE_URL}
Environment=GEMINI_MODEL=${GEMINI_MODEL}
Environment=GEMINI_THINKING_LEVEL=${GEMINI_THINKING_LEVEL}
Environment=POSTGRES_HOST=${HOLOLIVE_CENTRAL_POSTGRES_HOST}
Environment=POSTGRES_PORT=${HOLOLIVE_CENTRAL_POSTGRES_PORT}
Environment=POSTGRES_SOCKET_PATH=
Environment=POSTGRES_DB=hololive
Environment=POSTGRES_USER=hololive_runtime
Environment=POSTGRES_SSLMODE=${POSTGRES_SSLMODE}
Environment=POSTGRES_SSLROOTCERT=${POSTGRES_SSLROOTCERT}
Environment=POSTGRES_QUERY_EXEC_MODE=${POSTGRES_QUERY_EXEC_MODE}
Environment=CACHE_SOCKET_PATH=
Environment=CACHE_HOST=
Environment=CACHE_PORT=16379
Environment=CACHE_PASSWORD=
Environment=HOLOLIVE_H3_CERT_FILE=${HOLOLIVE_H3_CERT_FILE}
Environment=HOLOLIVE_H3_KEY_FILE=${HOLOLIVE_H3_KEY_FILE}
Environment=HOLOLIVE_INTERNAL_H3_CA_CERT_FILE=${HOLOLIVE_INTERNAL_H3_CA_CERT_FILE}
Environment=HOLOLIVE_INTERNAL_H3_SERVER_NAME=${HOLOLIVE_INTERNAL_H3_SERVER_NAME}
Environment=HEALTHCHECK_CA_CERT_FILE=${HOLOLIVE_H3_CERT_FILE}
Environment=HEALTHCHECK_SERVER_NAME=${HOLOLIVE_H3_SERVER_NAME}
Environment=IRIS_BASE_URL=${IRIS_BASE_URL}
Environment=IRIS_BASE_URL_FILE=${IRIS_BASE_URL_FILE}
Environment=IRIS_TRANSPORT=${IRIS_TRANSPORT}
Environment=IRIS_H3_CA_CERT_FILE=${IRIS_H3_CA_CERT_FILE}
Environment=IRIS_H3_SERVER_NAME=${IRIS_H3_SERVER_NAME}
Environment=LOG_LEVEL=${LOG_LEVEL}
Environment=LOG_MAX_SIZE_MB=${LOG_MAX_SIZE_MB}
Environment=LOG_MAX_BACKUPS=${LOG_MAX_BACKUPS}
Environment=LOG_MAX_AGE_DAYS=${LOG_MAX_AGE_DAYS}
Environment=LOG_COMPRESS=${LOG_COMPRESS}
Environment=PGAPPNAME=hololive-api
Environment=APP_ENV=production
Environment=STACK_WORKER_PROFILE_FILE=/run/hololive-bot/worker-profiles/hololive-api.json
Environment=SERVER_PORT=30001
Environment=HOLOLIVE_HTTP_TRANSPORTS=${HOLOLIVE_HTTP_TRANSPORTS}
Environment=HOLOLIVE_H3_ADDR=${HOLOLIVE_H3_ADDR}
Environment=HOLOLIVE_METRICS_ADDR=${HOLOLIVE_API_METRICS_ADDR}
Environment=HOLOLIVE_PPROF_ADDR=${HOLOLIVE_API_PPROF_ADDR}
Environment=HOLOLIVE_ADMIN_API_PORT=30006
Environment=HOLOLIVE_ADMIN_API_HTTP_TRANSPORTS=${HOLOLIVE_ADMIN_API_HTTP_TRANSPORTS}
Environment=HOLOLIVE_ADMIN_API_H3_ADDR=${HOLOLIVE_ADMIN_API_H3_ADDR}
Environment=LLM_SCHEDULER_PORT=30003
Environment=HOLOLIVE_LLM_SCHEDULER_HTTP_TRANSPORTS=${HOLOLIVE_LLM_SCHEDULER_HTTP_TRANSPORTS}
Environment=HOLOLIVE_LLM_SCHEDULER_H3_ADDR=${HOLOLIVE_LLM_SCHEDULER_H3_ADDR}
Environment=ALARM_INTERNAL_URL=https://hololive-alarm-worker:30007
Environment=BOT_POSTGRES_POOL_MIN_CONNS=${BOT_POSTGRES_POOL_MIN_CONNS}
Environment=BOT_POSTGRES_POOL_MAX_CONNS=${BOT_POSTGRES_POOL_MAX_CONNS}
Environment=ADMIN_API_POSTGRES_POOL_MIN_CONNS=${ADMIN_API_POSTGRES_POOL_MIN_CONNS}
Environment=ADMIN_API_POSTGRES_POOL_MAX_CONNS=${ADMIN_API_POSTGRES_POOL_MAX_CONNS}
Environment=LLM_SCHEDULER_POSTGRES_POOL_MIN_CONNS=${LLM_SCHEDULER_POSTGRES_POOL_MIN_CONNS}
Environment=LLM_SCHEDULER_POSTGRES_POOL_MAX_CONNS=${LLM_SCHEDULER_POSTGRES_POOL_MAX_CONNS}
Environment=YOUTUBE_PLANE_POSTGRES_POOL_MIN_CONNS=${YOUTUBE_PLANE_POSTGRES_POOL_MIN_CONNS}
Environment=YOUTUBE_PLANE_POSTGRES_POOL_MAX_CONNS=${YOUTUBE_PLANE_POSTGRES_POOL_MAX_CONNS}
Environment=YOUTUBE_PLANE_TIME_FINALIZATION_BACKLOG_BATCH_SIZE=${YOUTUBE_PLANE_TIME_FINALIZATION_BACKLOG_BATCH_SIZE}
Environment=YOUTUBE_PLANE_RETENTION_INTERVAL_SECONDS=${YOUTUBE_PLANE_RETENTION_INTERVAL_SECONDS}
Environment=YOUTUBE_PLANE_RETENTION_BATCH_SIZE=${YOUTUBE_PLANE_RETENTION_BATCH_SIZE}
Environment=YOUTUBE_PLANE_RETENTION_QUEUE_PROCESSED_DAYS=${YOUTUBE_PLANE_RETENTION_QUEUE_PROCESSED_DAYS}
Environment=YOUTUBE_PLANE_RETENTION_QUEUE_DLQ_DAYS=${YOUTUBE_PLANE_RETENTION_QUEUE_DLQ_DAYS}
Environment=YOUTUBE_PLANE_RETENTION_COLLISION_DAYS=${YOUTUBE_PLANE_RETENTION_COLLISION_DAYS}
Environment=YOUTUBE_PLANE_RETENTION_LIVE_ABSENCE_SLOTS_DAYS=${YOUTUBE_PLANE_RETENTION_LIVE_ABSENCE_SLOTS_DAYS}
Environment=YOUTUBE_PLANE_RETENTION_CONTENT_ABSENCE_SLOTS_DAYS=${YOUTUBE_PLANE_RETENTION_CONTENT_ABSENCE_SLOTS_DAYS}
Environment=YOUTUBE_PLANE_RETENTION_CHECKPOINT_HISTORY_DAYS=${YOUTUBE_PLANE_RETENTION_CHECKPOINT_HISTORY_DAYS}
Environment=YOUTUBE_PLANE_RETENTION_PROJECTION_RETIRED_DAYS=${YOUTUBE_PLANE_RETENTION_PROJECTION_RETIRED_DAYS}
Environment=YOUTUBE_PLANE_RETENTION_COMMUNITY_PAGE_DAYS=${YOUTUBE_PLANE_RETENTION_COMMUNITY_PAGE_DAYS}
Environment=YOUTUBE_PLANE_RETENTION_VIDEO_LIST_DAYS=${YOUTUBE_PLANE_RETENTION_VIDEO_LIST_DAYS}
Environment=YOUTUBE_PLANE_RETENTION_SHORTS_LIST_DAYS=${YOUTUBE_PLANE_RETENTION_SHORTS_LIST_DAYS}
Environment=YOUTUBE_PLANE_RETENTION_LIVE_SNAPSHOT_DAYS=${YOUTUBE_PLANE_RETENTION_LIVE_SNAPSHOT_DAYS}
Environment=YOUTUBE_PLANE_RETENTION_CHANNEL_PROFILE_DAYS=${YOUTUBE_PLANE_RETENTION_CHANNEL_PROFILE_DAYS}
Environment=YOUTUBE_PLANE_RETENTION_CHANNEL_PHOTO_DAYS=${YOUTUBE_PLANE_RETENTION_CHANNEL_PHOTO_DAYS}
Environment=YOUTUBE_PLANE_RETENTION_SCHEDULE_SNAPSHOT_DAYS=${YOUTUBE_PLANE_RETENTION_SCHEDULE_SNAPSHOT_DAYS}
Environment=YOUTUBE_PLANE_RETENTION_CHANNEL_LIVE_CHECK_DAYS=${YOUTUBE_PLANE_RETENTION_CHANNEL_LIVE_CHECK_DAYS}
Environment=YOUTUBE_PLANE_RETENTION_VIDEO_LIVE_CHECK_DAYS=${YOUTUBE_PLANE_RETENTION_VIDEO_LIVE_CHECK_DAYS}
Environment=PHOTO_SYNC_ENABLED=${PHOTO_SYNC_ENABLED}
Environment=KAKAO_ROOMS=${KAKAO_ROOMS}
Environment=KAKAO_ACL_ENABLED=${KAKAO_ACL_ENABLED}
Environment=KAKAO_ACL_MODE=${KAKAO_ACL_MODE}
Environment=NOTIFICATION_EGRESS_ROLE=producer
Environment=NOTIFICATION_SCHEDULER_ROLE=off
Environment=LOG_DIR=/app/logs
Environment=GOGC=80
Environment=GOMEMLIMIT=600MiB
Environment=GIN_MODE=release
Environment=IRIS_BASE_URL_ALLOWED_HOSTS=${IRIS_BASE_URL_ALLOWED_HOSTS}
Environment=HOLOLIVE_SHORT_LINK_ADDR=:30101
Environment=CACHE_SENTINEL_MASTER_SET=hololive
Environment=CACHE_SENTINEL_ADDRS=${VALKEY_SENTINEL_ADDRS}
Environment=CACHE_SENTINEL_USERNAME=hololive-discovery
Environment=CACHE_SENTINEL_PASSWORD_FILE=/run/hololive-bot/certs/valkey-discovery-password
Environment=CACHE_TLS_CA_FILE=/run/hololive-bot/certs/iris-ca.pem
Environment=CACHE_USERNAME=hololive-api
Environment=CACHE_PASSWORD_FILE=/run/hololive-bot/certs/valkey-api-password
# APP_VERSION과 비밀번호·API key는 prestart가 root 전용 env 파일로 넘긴다.
EnvironmentFile=/run/hololive-bot/quadlet-env/hololive-api.env
# 세 endpoint를 순차 검사하므로 URL별 5s 제한의 합보다 길어야 한다.
HealthCmd=["./bin/healthcheck","--api-key-env","API_SECRET_KEY","https://127.0.0.1:30001/health","https://127.0.0.1:30003/internal/ready","https://127.0.0.1:30006/health"]
HealthInterval=30s
HealthTimeout=20s
HealthRetries=3
HealthStartPeriod=45s
HealthStartupCmd=["./bin/healthcheck","--api-key-env","API_SECRET_KEY","https://127.0.0.1:30001/health","https://127.0.0.1:30003/internal/ready","https://127.0.0.1:30006/health"]
HealthStartupInterval=5s
HealthStartupTimeout=20s
# unhealthy면 SIGTERM·StopTimeout(45초)으로 정지한 뒤 Restart=always가 다시 띄운다.
# kill(SIGKILL)은 진행 중인 webhook 응답·outbox 전송을 끊는다.
HealthOnFailure=stop
Notify=healthy

[Service]
Environment=HOLOLIVE_API_IMAGE=localhost/hololive-api:prod
Environment=HOLOLIVE_RUNTIME_GID=1002
Environment=HOLOLIVE_METRICS_PORT_BIND_IP=127.0.0.1
Environment=TAILSCALE_DNS_RESOLVER=100.100.100.100
Environment=HOLOLIVE_CENTRAL_POSTGRES_HOST=holo-postgres
Environment=HOLOLIVE_CENTRAL_POSTGRES_PORT=5432
Environment=POSTGRES_SSLMODE=verify-full
Environment=POSTGRES_SSLROOTCERT=/run/hololive-bot/certs/postgres-ca.pem
Environment=POSTGRES_QUERY_EXEC_MODE=cache_statement
Environment=HOLOLIVE_H3_CERT_FILE=/run/hololive-bot/certs/hololive-h3.crt
Environment=HOLOLIVE_H3_KEY_FILE=/run/hololive-bot/certs/hololive-h3.key
Environment=HOLOLIVE_INTERNAL_H3_CA_CERT_FILE=/run/hololive-bot/certs/hololive-h3.crt
Environment=HOLOLIVE_INTERNAL_H3_SERVER_NAME=127.0.0.1
Environment=IRIS_BASE_URL=
Environment=IRIS_BASE_URL_FILE=/app/runtime-config/iris_base_url
Environment=IRIS_TRANSPORT=h3
Environment=IRIS_H3_CA_CERT_FILE=/run/hololive-bot/certs/iris-ca.pem
Environment=IRIS_H3_SERVER_NAME=
Environment=LOG_LEVEL=info
Environment=LOG_MAX_SIZE_MB=5
Environment=LOG_MAX_BACKUPS=5
Environment=LOG_MAX_AGE_DAYS=30
Environment=LOG_COMPRESS=true
Environment=HOLOLIVE_HTTP_TRANSPORTS=h3
Environment=HOLOLIVE_H3_ADDR=:30001
Environment=HOLOLIVE_API_METRICS_ADDR=:30091
Environment=HOLOLIVE_API_PPROF_ADDR=:30061
Environment=HOLOLIVE_ADMIN_API_HTTP_TRANSPORTS=h3
Environment=HOLOLIVE_ADMIN_API_H3_ADDR=:30006
Environment=HOLOLIVE_LLM_SCHEDULER_HTTP_TRANSPORTS=h3
Environment=HOLOLIVE_LLM_SCHEDULER_H3_ADDR=:30003
Environment=BOT_POSTGRES_POOL_MAX_CONNS=4
Environment=ADMIN_API_POSTGRES_POOL_MAX_CONNS=4
Environment=LLM_SCHEDULER_POSTGRES_POOL_MAX_CONNS=4
Environment=YOUTUBE_PLANE_POSTGRES_POOL_MAX_CONNS=2
Environment=YOUTUBE_PLANE_TIME_FINALIZATION_BACKLOG_BATCH_SIZE=0
Environment=PHOTO_SYNC_ENABLED=true
Environment=KAKAO_ROOMS=
Environment=KAKAO_ACL_ENABLED=true
Environment=KAKAO_ACL_MODE=whitelist
Environment=IRIS_BASE_URL_ALLOWED_HOSTS=100.100.1.5
EnvironmentFile=/etc/stack-secrets/hololive-bot/compose.env
ExecStartPre=/usr/local/libexec/hololive-bot/quadlet-prestart hololive-api
Restart=always
RestartSec=5s
TimeoutStartSec=180
LogRateLimitIntervalSec=0

[Install]
WantedBy=multi-user.target
