# 중앙 YouTube collector fleet member c다. 기존 deunhealth 예외(restart.on.unhealthy=false)를 유지해
# unhealthy만으로는 kill하지 않는다. process 종료는 systemd가 다시 띄운다.
# compose.env의 HOLOLIVE_DISABLE_YOUTUBE_COLLECTOR=1이면 ExecCondition이 기동을 건너뛴다.
[Unit]
Description=Hololive central YouTube collector c
# 런타임 peer는 Wants=로만 끌어온다. Requires=는 명시적 stop/restart를 전파해 primary fence(소비자 유지)와
# Sentinel HA(로컬 노드 교체)를 깨뜨린다.
Wants=holo-postgres.service
After=holo-postgres.service tailscaled.service
ConditionPathExists=!/var/lib/hololive-postgres-fence/fence.intent
ConditionPathExists=!/var/lib/hololive-postgres-fence/fenced
StartLimitIntervalSec=0

[Container]
ContainerName=hololive-youtube-collector-c
Image=${HOLOLIVE_YOUTUBE_COLLECTOR_IMAGE}
Pull=never
User=1000
Group=1000
GroupAdd=${HOLOLIVE_RUNTIME_GID}
# 호스트 ID와 분리한다. 크기 65536은 PO socket 소유자 65532 매핑에 필요하고, 그룹 비밀은 GID를 그대로 매핑해 읽는다(worker-profile-pair.py가 profile mount 줄을 비교).
UserNS=auto:size=65536,gidmapping=${HOLOLIVE_RUNTIME_GID}:${HOLOLIVE_RUNTIME_GID}:1
Network=hololive-net.network:alias=youtube-collector-c
Network=observability-traces.network
PublishPort=127.0.0.1:30025:30025
PublishPort=127.0.0.1:30025:30025/udp
PublishPort=${HOLOLIVE_METRICS_PORT_BIND_IP}:30096:30096
DNS=${TAILSCALE_DNS_RESOLVER}
DNS=8.8.8.8
DNS=1.1.1.1
AddHost=host.docker.internal:host-gateway
Entrypoint=./bin/youtube-collector
Volume=/opt/hololive-bot/compose/current/data:/app/data:idmap
Volume=${LIVE_LOGS_PATH}:/app/logs:idmap
Volume=/etc/stack-secrets/hololive-bot/certs/postgres-ca.pem:/run/hololive-bot/certs/postgres-ca.pem:ro
Volume=/etc/stack-secrets/hololive-bot/certs/hololive-h3.crt:/run/hololive-bot/certs/hololive-h3.crt:ro
Volume=/etc/stack-secrets/hololive-bot/certs/hololive-h3.key:/run/hololive-bot/certs/hololive-h3.key:ro
Volume=/etc/stack-secrets/hololive-bot/worker-profiles:/run/hololive-bot/worker-profiles:ro
Volume=youtube-po-c-socket.volume:/run/hololive-youtube-po:ro,idmap
Tmpfs=/tmp:size=64m,mode=1777,noexec,nosuid,nodev
ReadOnly=true
ReadOnlyTmpfs=false
NoNewPrivileges=true
DropCapability=all
# 상한(768m)은 Go 320MiB에 YouTube.js Node helper(관측 최대 176MiB) 몫 192MiB와 여유 32MiB를 더한 값보다 크게 둔다.
Memory=768m
PidsLimit=256
LogDriver=journald
EnvironmentFile=/etc/stack-secrets/hololive-bot/youtube-collector.env
Environment=HOLOLIVE_H3_CERT_FILE=${HOLOLIVE_H3_CERT_FILE}
Environment=HOLOLIVE_H3_KEY_FILE=${HOLOLIVE_H3_KEY_FILE}
Environment=HOLOLIVE_INTERNAL_H3_CA_CERT_FILE=${HOLOLIVE_INTERNAL_H3_CA_CERT_FILE}
Environment=HOLOLIVE_INTERNAL_H3_SERVER_NAME=${HOLOLIVE_INTERNAL_H3_SERVER_NAME}
Environment=HEALTHCHECK_CA_CERT_FILE=${HOLOLIVE_H3_CERT_FILE}
Environment=HEALTHCHECK_SERVER_NAME=${HOLOLIVE_H3_SERVER_NAME}
Environment=LOG_LEVEL=${LOG_LEVEL}
Environment=LOG_MAX_SIZE_MB=${LOG_MAX_SIZE_MB}
Environment=LOG_MAX_BACKUPS=${LOG_MAX_BACKUPS}
Environment=LOG_MAX_AGE_DAYS=${LOG_MAX_AGE_DAYS}
Environment=LOG_COMPRESS=${LOG_COMPRESS}
Environment=POSTGRES_HOST=${HOLOLIVE_CENTRAL_POSTGRES_HOST}
Environment=POSTGRES_PORT=${HOLOLIVE_CENTRAL_POSTGRES_PORT}
Environment=POSTGRES_SOCKET_PATH=
Environment=POSTGRES_DB=hololive
Environment=POSTGRES_SSLMODE=${POSTGRES_SSLMODE}
Environment=POSTGRES_SSLROOTCERT=${POSTGRES_SSLROOTCERT}
Environment=POSTGRES_QUERY_EXEC_MODE=${POSTGRES_QUERY_EXEC_MODE}
Environment=PGAPPNAME=youtube-collector-c
Environment=NOTIFICATION_EGRESS_ROLE=off
Environment=STACK_WORKER_PROFILE_FILE=/run/hololive-bot/worker-profiles/youtube-collector-c.json
Environment=YOUTUBE_COLLECTOR_RUNTIME_ALLOWED=true
Environment=YOUTUBE_COLLECTOR_INSTANCE_ID=youtube-collector-c
Environment=YOUTUBE_COLLECTOR_LOG_FILE_NAME=youtube-collector-c.log
Environment=POSTGRES_USER=hololive_scraper
Environment=SERVER_PORT=30025
Environment=HOLOLIVE_HTTP_TRANSPORTS=${HOLOLIVE_YOUTUBE_COLLECTOR_HTTP_TRANSPORTS}
Environment=HOLOLIVE_H3_ADDR=${HOLOLIVE_YOUTUBE_COLLECTOR_H3_ADDR}
Environment=HOLOLIVE_METRICS_ADDR=${HOLOLIVE_YOUTUBE_COLLECTOR_METRICS_ADDR}
Environment=POSTGRES_POOL_MIN_CONNS=${YOUTUBE_COLLECTOR_POSTGRES_POOL_MIN_CONNS}
Environment=POSTGRES_POOL_MAX_CONNS=${YOUTUBE_COLLECTOR_POSTGRES_POOL_MAX_CONNS}
Environment=YOUTUBE_COLLECTOR_READINESS_TIMEOUT_SECONDS=${YOUTUBE_COLLECTOR_READINESS_TIMEOUT_SECONDS}
Environment=YOUTUBE_COLLECTOR_HELPER_HEALTH_TIMEOUT_SECONDS=${YOUTUBE_COLLECTOR_HELPER_HEALTH_TIMEOUT_SECONDS}
Environment=YOUTUBE_COLLECTOR_YOUTUBEJS_REQUEST_TIMEOUT_SECONDS=${YOUTUBE_COLLECTOR_YOUTUBEJS_REQUEST_TIMEOUT_SECONDS}
Environment=YOUTUBE_COLLECTOR_YOUTUBEJS_STARTUP_TIMEOUT_SECONDS=${YOUTUBE_COLLECTOR_YOUTUBEJS_STARTUP_TIMEOUT_SECONDS}
Environment=YOUTUBE_COLLECTOR_YOUTUBEJS_SHUTDOWN_TIMEOUT_SECONDS=${YOUTUBE_COLLECTOR_YOUTUBEJS_SHUTDOWN_TIMEOUT_SECONDS}
Environment=YOUTUBE_COLLECTOR_MAX_PAGES=${YOUTUBE_COLLECTOR_MAX_PAGES}
Environment=YOUTUBE_COLLECTOR_MAX_SUCCESS_RESPONSE_BYTES=${YOUTUBE_COLLECTOR_MAX_SUCCESS_RESPONSE_BYTES}
Environment=YOUTUBE_COLLECTOR_MAX_TARGET_ROSTER_ROWS=${YOUTUBE_COLLECTOR_MAX_TARGET_ROSTER_ROWS}
Environment=PHOTO_SYNC_ENABLED=false
Environment=GOGC=100
Environment=GOMEMLIMIT=320MiB
Environment=GIN_MODE=release
Environment=LOG_DIR=/app/logs
EnvironmentFile=/run/hololive-bot/quadlet-env/hololive-youtube-collector-c.env
HealthCmd=["./bin/healthcheck","https://127.0.0.1:30025/ready"]
HealthInterval=30s
HealthTimeout=7s
HealthRetries=3
# 이전 인스턴스의 60초 lease 만료와 첫 publish가 끝날 때까지 기동 유예를 적용한다.
HealthStartPeriod=180s
HealthStartupCmd=["./bin/healthcheck","https://127.0.0.1:30025/ready"]
HealthStartupInterval=5s
HealthStartupTimeout=7s
Notify=healthy

[Service]
Environment=HOLOLIVE_YOUTUBE_COLLECTOR_IMAGE=localhost/hololive-youtube-collector:prod
Environment=HOLOLIVE_RUNTIME_GID=1002
Environment=HOLOLIVE_METRICS_PORT_BIND_IP=127.0.0.1
Environment=TAILSCALE_DNS_RESOLVER=100.100.100.100
Environment=HOLOLIVE_DISABLE_YOUTUBE_COLLECTOR=
Environment=HOLOLIVE_H3_CERT_FILE=/run/hololive-bot/certs/hololive-h3.crt
Environment=HOLOLIVE_H3_KEY_FILE=/run/hololive-bot/certs/hololive-h3.key
Environment=HOLOLIVE_INTERNAL_H3_CA_CERT_FILE=/run/hololive-bot/certs/hololive-h3.crt
Environment=HOLOLIVE_INTERNAL_H3_SERVER_NAME=127.0.0.1
Environment=HOLOLIVE_H3_SERVER_NAME=127.0.0.1
Environment=LOG_LEVEL=info
Environment=LOG_MAX_SIZE_MB=5
Environment=LOG_MAX_BACKUPS=5
Environment=LOG_MAX_AGE_DAYS=30
Environment=LOG_COMPRESS=true
Environment=HOLOLIVE_CENTRAL_POSTGRES_HOST=holo-postgres
Environment=HOLOLIVE_CENTRAL_POSTGRES_PORT=5432
Environment=POSTGRES_SSLMODE=verify-full
Environment=POSTGRES_SSLROOTCERT=/run/hololive-bot/certs/postgres-ca.pem
Environment=POSTGRES_QUERY_EXEC_MODE=cache_statement
Environment=HOLOLIVE_YOUTUBE_COLLECTOR_HTTP_TRANSPORTS=h3
Environment=HOLOLIVE_YOUTUBE_COLLECTOR_H3_ADDR=:30025
Environment=HOLOLIVE_YOUTUBE_COLLECTOR_METRICS_ADDR=:30096
Environment=YOUTUBE_COLLECTOR_POSTGRES_POOL_MIN_CONNS=2
Environment=YOUTUBE_COLLECTOR_POSTGRES_POOL_MAX_CONNS=7
Environment=YOUTUBE_COLLECTOR_READINESS_TIMEOUT_SECONDS=2
Environment=YOUTUBE_COLLECTOR_HELPER_HEALTH_TIMEOUT_SECONDS=1
Environment=YOUTUBE_COLLECTOR_YOUTUBEJS_REQUEST_TIMEOUT_SECONDS=30
Environment=YOUTUBE_COLLECTOR_YOUTUBEJS_STARTUP_TIMEOUT_SECONDS=30
Environment=YOUTUBE_COLLECTOR_YOUTUBEJS_SHUTDOWN_TIMEOUT_SECONDS=3
Environment=YOUTUBE_COLLECTOR_MAX_PAGES=1
Environment=YOUTUBE_COLLECTOR_MAX_SUCCESS_RESPONSE_BYTES=1048576
Environment=YOUTUBE_COLLECTOR_MAX_TARGET_ROSTER_ROWS=10000
EnvironmentFile=/etc/stack-secrets/hololive-bot/compose.env
ExecCondition=/usr/local/libexec/hololive-bot/quadlet-prestart collector-enabled
ExecStartPre=/usr/local/libexec/hololive-bot/quadlet-prestart hololive-youtube-collector-c
Restart=always
RestartSec=5s
TimeoutStartSec=300
LogRateLimitIntervalSec=0

[Install]
WantedBy=multi-user.target
