worker_processes 1;
pid /var/run/nginx.pid;

events {
    worker_connections 256;
}

http {
    access_log /dev/stdout;
    error_log /dev/stderr warn;

    # Seoul gateway가 proxy.conf에서 $proxy_add_x_forwarded_for로 자기 $remote_addr를
    # 목록 끝에 덧붙이므로 마지막 항목만 gateway가 쓴 값이다. 앞쪽 항목은 클라이언트가
    # 위조할 수 있어 rate limit 키로 쓰면 그대로 우회된다.
    map $http_x_forwarded_for $shortlink_client {
        default                                       $binary_remote_addr;
        "~(?<shortlink_gateway_client>[^,\s]+)\s*$"   $shortlink_gateway_client;
    }

    limit_req_zone $shortlink_client zone=shortlink_requests:1m rate=20r/s;
    # 동시성 상한은 의도적으로 전역이다. ingress -> 30101 upstream 전체를 막는 backstop.
    limit_conn_zone $binary_remote_addr zone=shortlink_connections:1m;
    limit_req_status 429;
    limit_conn_status 429;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        "" close;
    }

    map $http_x_forwarded_for $forwarded_for {
        "" $remote_addr;
        default $http_x_forwarded_for;
    }

    map $http_x_forwarded_proto $forwarded_proto {
        "" http;
        default $http_x_forwarded_proto;
    }

    server {
        listen @BIND_IP@:30191;
        server_name _;

        allow 127.0.0.1;
        allow @BIND_IP@;
        allow 100.100.1.5;
        deny all;

        location / {
            proxy_pass http://127.0.0.1:30190;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $forwarded_for;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Proto $forwarded_proto;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
        }
    }

    server {
        listen @BIND_IP@:30192;
        server_name _;

        allow 127.0.0.1;
        allow @BIND_IP@;
        allow 100.100.1.5;
        deny all;

        location = /healthz {
            access_log off;
            return 200 "ok\n";
        }

        location ^~ /l/ {
            limit_req zone=shortlink_requests burst=40 nodelay;
            limit_conn shortlink_connections 32;
            proxy_pass http://127.0.0.1:30101;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $forwarded_for;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Proto $forwarded_proto;
            proxy_connect_timeout 5s;
            proxy_read_timeout 10s;
            proxy_send_timeout 10s;
        }

        location / {
            return 404;
        }
    }
}
