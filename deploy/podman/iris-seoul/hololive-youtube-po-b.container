# youtube-collector-b의 PO issuer(2026-11-06 iris-seoul Docker Compose에서 전환). 격리 조건은 compose po-b와 같다.
[Unit]
Description=hololive YouTube PO issuer for collector b
StartLimitIntervalSec=0

[Container]
ContainerName=hololive-youtube-po-b
Image=localhost/hololive-youtube-po-sandbox:prod
Pull=never
User=65532
Group=1000
Network=none
ReadOnly=true
ReadOnlyTmpfs=false
Tmpfs=/tmp:size=64m,mode=1777,U,noexec,nosuid,nodev
DropCapability=ALL
NoNewPrivileges=true
Ulimit=core=0:0
PidsLimit=32
Memory=512m
PodmanArgs=--cpus=1
ShmSize=64m
Volume=hololive-youtube-po-b.volume:/run/hololive-youtube-po
HealthCmd=["/app/bin/po-broker","--healthcheck","--socket","/run/hololive-youtube-po/worker.sock"]
HealthInterval=30s
HealthTimeout=5s
HealthStartPeriod=5s
HealthStartupCmd=["/app/bin/po-broker","--healthcheck","--socket","/run/hololive-youtube-po/worker.sock"]
HealthStartupInterval=2s
HealthStartupTimeout=5s
Notify=healthy
LogDriver=journald

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
