# hololive YouTube collector 전용 bridge. metrics는 게시하지 않고 Prometheus(obs-prometheus)가
# 고정 컨테이너 IP로 직접 수집한다(10.89.15.<slot>: d=14. a=11·b=12는 예전 배치의 예약값).
# InterfaceName은 rhel-host-security kapu.conf의 PODMAN_IFACES가 firewalld podman zone에 넣는다. 목록에 없는
# bridge는 firewalld reload 뒤 public zone으로 떨어져 DNS와 egress를 잃는다.
[Network]
NetworkName=hololive-collector
Subnet=10.89.15.0/24
Gateway=10.89.15.1
InterfaceName=pm-hcollect
