package docker

import (
	"context"
	"encoding/json/v2"
	"errors"
	"io"
	"net/http"
	"net/http/httptest"
	"strings"
	"sync/atomic"
	"testing"
	"time"
)

func TestPatchedDockerAPI(t *testing.T) {
	var pings, restarts atomic.Int32
	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		if r.URL.Path == "/_ping" {
			pings.Add(1)
			w.Header().Set("API-Version", "1.52")
			w.WriteHeader(http.StatusOK)
			return
		}
		if !strings.HasPrefix(r.URL.Path, "/v1.52/") {
			t.Errorf("API negotiation was not preserved: %s", r.URL.Path)
			http.Error(w, "unexpected API version", http.StatusBadRequest)
			return
		}
		w.Header().Set("Content-Type", "application/json")
		switch strings.TrimPrefix(r.URL.Path, "/v1.52") {
		case "/containers/json", "/events":
			var filters map[string]map[string]bool
			if err := json.Unmarshal([]byte(r.URL.Query().Get("filters")), &filters); err != nil {
				t.Errorf("invalid filters: %v", err)
			}
			if !filters["label"]["deunhealth.restart.on.unhealthy=true"] {
				t.Errorf("restart opt-in label is missing: %v", filters)
			}
			if strings.HasSuffix(r.URL.Path, "/json") {
				_, _ = io.WriteString(w, `[{"Id":"fixture","Image":"test/image","Names":["/fixture"]}]`)
				return
			}
			if !filters["health"]["unhealthy"] {
				t.Errorf("unhealthy filter is missing: %v", filters)
			}
			_, _ = io.WriteString(w, "{\"Type\":\"container\",\"Action\":\"health_status: unhealthy\",\"Actor\":{\"ID\":\"fixture\",\"Attributes\":{\"name\":\"fixture\",\"image\":\"test/image\"}}}\n")
			w.(http.Flusher).Flush()
			<-r.Context().Done()
		case "/containers/fixture/restart":
			if r.Method != http.MethodPost || r.URL.RawQuery != "" {
				t.Errorf("restart method or default timeout changed: %s %s", r.Method, r.URL.RawQuery)
			}
			restarts.Add(1)
			w.WriteHeader(http.StatusNoContent)
		case "/containers/failure/restart":
			w.WriteHeader(http.StatusInternalServerError)
			_, _ = io.WriteString(w, `{"message":"fixture failure"}`)
		default:
			t.Errorf("unexpected Docker request: %s", r.URL.Path)
			w.WriteHeader(http.StatusNotFound)
		}
	}))
	t.Cleanup(server.Close)
	docker, err := New(strings.Replace(server.URL, "http://", "tcp://", 1))
	if err != nil {
		t.Fatal(err)
	}
	t.Cleanup(func() { _ = docker.client.Close() })
	ctx, cancel := context.WithTimeout(t.Context(), 5*time.Second)
	defer cancel()
	containers, err := docker.GetUnhealthy(ctx)
	if err != nil || len(containers) != 1 || containers[0].ID != "fixture" || containers[0].Name != "fixture" {
		t.Fatalf("unhealthy listing: %#v, %v", containers, err)
	}
	labeled, err := docker.GetLabeled(ctx, []string{"deunhealth.restart.on.unhealthy=true"})
	if err != nil || len(labeled) != 1 || labeled[0].Name != "/fixture" {
		t.Fatalf("labeled listing: %#v, %v", labeled, err)
	}
	if err := docker.RestartContainer(ctx, "fixture"); err != nil {
		t.Fatal(err)
	}
	if err := docker.RestartContainer(ctx, "failure"); err == nil {
		t.Fatal("Docker restart failure was hidden")
	}
	ready := make(chan struct{})
	unhealthy := make(chan Container)
	crashed := make(chan error, 1)
	go docker.StreamUnhealthy(ctx, ready, unhealthy, crashed)
	select {
	case <-ready:
	case <-ctx.Done():
		t.Fatal(ctx.Err())
	}
	select {
	case container := <-unhealthy:
		if container.ID != "fixture" || container.Image != "test/image" {
			t.Fatalf("unexpected event: %#v", container)
		}
	case err := <-crashed:
		t.Fatal(err)
	case <-ctx.Done():
		t.Fatal(ctx.Err())
	}
	cancel()
	select {
	case err := <-crashed:
		if !errors.Is(err, context.Canceled) {
			t.Fatalf("event cancellation: %v", err)
		}
	case <-time.After(5 * time.Second):
		t.Fatal("event reader did not stop")
	}
	if pings.Load() != 1 || restarts.Load() != 1 {
		t.Fatalf("unexpected request counts: ping=%d restart=%d", pings.Load(), restarts.Load())
	}
}
