{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "maxNodeModuleJsDepth": 0
  },
  "include": ["src/**/*.mjs", "src/**/*.d.ts"],
  "exclude": [
    "src/**/*.test.mjs",
    "src/server.mjs",
    "src/helper-runtime.mjs",
    "src/rpc-boundary.mjs",
    "src/rpc-errors.mjs",
    "src/rpc-execution.mjs",
    "src/rpc-validation-primitives.mjs",
    "src/rpc-collection-validation.mjs",
    "src/rpc-live-check-validation.mjs",
    "src/real-fetchers.mjs"
  ]
}
