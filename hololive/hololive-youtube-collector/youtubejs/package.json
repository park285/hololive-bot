{
  "name": "hololive-youtube-collector-youtubejs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^24.21.0"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 src/*.test.mjs",
    "test:pagination-performance": "node --expose-gc src/pagination-performance.mjs",
    "start": "node src/server.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p jsconfig.json"
  },
  "dependencies": {
    "undici": "8.11.0",
    "youtubei.js": "18.1.0"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "typescript": "7.0.2"
  },
  "packageManager": "npm@11.19.0"
}
