# Hololive 환경 변수 예시
# 이 파일을 .env로 복사하고 실제 값을 입력하세요.
# 모든 시크릿은 placeholder로 제공되며 운영 전 반드시 변경해야 합니다.

# PostgreSQL (필수)
DB_PASSWORD=
POSTGRES_ADMIN_USER=postgres_admin
HOLOLIVE_MIGRATOR_USER=hololive_migrator
# 역할별 전용 비밀번호(필수). DB_PASSWORD는 postgres admin 비밀번호이며 역할 비밀번호로 쓰지 않습니다.
# 기존 DB에 적용하려면 ALTER ROLE 필요.
HOLOLIVE_SCRAPER_PASSWORD=
HOLOLIVE_DB_PASSWORD=
HOLOLIVE_MIGRATOR_PASSWORD=

# Valkey 캐시
CACHE_HOST=localhost
CACHE_PORT=6379
# 봇 Redis URL에 사용할 URL-safe hex 값을 권장합니다.
CACHE_PASSWORD=
# Tailnet publish 주소는 중앙 Quadlet prestart가 필수로 확인합니다.
VALKEY_BIND_IP=
# CACHE_SOCKET_PATH=/var/run/valkey/valkey-cache.sock

# 런타임 인증
# hololive-api admin 및 내부 API 인증 전용 키입니다.
API_SECRET_KEY=
# Collector H3 internal/metrics surface 인증 전용 키입니다.
# collector 배포에서는 scoped youtube-collector.env에만 제공합니다.
METRICS_API_KEY=
# 호스트 compose.env의 명시적 opt-in이다. 키·대상 설정과 DB migration을 먼저 준비한다.
HOLOLIVE_X_SPACES_ENABLED=0

# Iris·Kakao 봇
IRIS_BASE_URL=
IRIS_TRANSPORT=h3
IRIS_H3_CA_CERT_FILE=/run/hololive-bot/certs/iris-ca.pem
IRIS_H3_SERVER_NAME=
IRIS_WEBHOOK_TOKEN=
IRIS_BOT_TOKEN=
# 방 ACL 첫 초기화 seed(hololive-api·alarm-worker 필수, 콤마 구분). 정확한 signed i64 chatID만 받으며,
# 방 이름 등 chatID가 아닌 항목이 있으면 hololive-api 기동이 거절됩니다. 기본값은 없습니다.
KAKAO_ROOMS=
HOLOLIVE_HTTP_TRANSPORTS=h3
HOLOLIVE_H3_ADDR=:30001
HOLOLIVE_H3_CERT_FILE=/run/hololive-bot/certs/hololive-h3.crt
HOLOLIVE_H3_KEY_FILE=/run/hololive-bot/certs/hololive-h3.key
HOLOLIVE_INTERNAL_H3_CA_CERT_FILE=/run/hololive-bot/certs/hololive-h3.crt
HOLOLIVE_INTERNAL_H3_SERVER_NAME=127.0.0.1
HOLOLIVE_ADMIN_API_HTTP_TRANSPORTS=h3
HOLOLIVE_ALARM_WORKER_HTTP_TRANSPORTS=h3
HOLOLIVE_YOUTUBE_COLLECTOR_HTTP_TRANSPORTS=h3
HOLOLIVE_BOT_PORT_BIND_IP=
ADMIN_DASHBOARD_PORT_BIND_IP=
# 운영상 동일 값을 사용할 수는 있지만 변수는 분리해서 유지하세요.
# compose 배포는 기본값 없이 이 세 값을 명시 주입해야 합니다.

# Holodex API 키
HOLODEX_API_KEY=your_holodex_key

# 공식 예정 일정 API
# API만 사용하며 HTML 조회·대체 경로는 지원하지 않습니다.
OFFICIAL_SCHEDULE_BASE_URL=https://schedule.hololive.tv
OFFICIAL_SCHEDULE_TIMEOUT_SECONDS=15
OFFICIAL_SCHEDULE_PAGE_CACHE_TTL_SECONDS=15
MAX_RESPONSE_BODY_BYTES=2097152

# YouTube
# Community 알림은 youtube-collector AP fleet(기본 compose up의 c) + hololive-api YouTube plane consumer가 모두 필요합니다.
# collector POSTGRES_PASSWORD는 HOLOLIVE_SCRAPER_PASSWORD를 사용합니다.
# worker·executor·queue·lease 설정은 stack-secrets가 배포한 역할별 STACK_WORKER_PROFILE_FILE이 소유합니다.
YOUTUBE_COLLECTOR_YOUTUBEJS_REQUEST_TIMEOUT_SECONDS=30
YOUTUBE_COLLECTOR_MAX_PAGES=1
YOUTUBE_COLLECTOR_MAX_SUCCESS_RESPONSE_BYTES=1048576

# 과거 방송 시각 확정 묶음 크기(0: 중지, 최대 1000). 신규 종료 확정 수집은 계속합니다.
YOUTUBE_PLANE_TIME_FINALIZATION_BACKLOG_BATCH_SIZE=0

# API YouTube 보존은 plane이 켜져 있으면 항상 실행합니다. 주기·묶음·보존 일수의 정본은
# hololive/hololive-api/internal/config/youtube_plane_retention.go 기본값이며, 바꿀 값만 compose.env에 둡니다.

# 관리자 사진 동기화
# 관리자 plane 기본값이며 collector unit은 false로 고정합니다.
PHOTO_SYNC_ENABLED=true


# 로그
LOG_LEVEL=info
# compose 운영 기본값:
# - 정본: application stdout/stderr (중앙은 journald, `journalctl -u <unit>`)
# - 파일 미러: /home/kapu/gemini/hololive-bot/logs/*.log
# - 압축 백업: /home/kapu/gemini/hololive-bot/logs/archive/*.gz
# 아래 값은 파일 미러 로테이션 기본값입니다.
LOG_MAX_SIZE_MB=5
LOG_MAX_BACKUPS=5
LOG_MAX_AGE_DAYS=30
LOG_COMPRESS=true
# 런타임 환경은 APP_ENV로만 지정합니다.
APP_ENV=production
# 보조 로그 파일은 기본 비활성입니다.
# ENABLE_LOG_MIRROR=1       # logs/mirror 사용 시에만
# ENABLE_LOG_AUX_FILES=1    # logs/backfill, logs/canary, logs/cron 사용 시에만
# stdout만 필요할 때 LOG_DIR를 직접 지정하세요.
# LOG_DIR=logs

# 통합 관리자 앱은 iris-seoul의 Iris Console(iris-console.service)이 소유합니다.
# 이 저장소에는 별도 웹 계정·이미지·secret 배포 설정이 없습니다.
# docs/current/runbooks/admin-dashboard.md를 따릅니다.

# live-compat 오버레이 사용 시 필수: 호스트 로그 디렉터리 절대경로
LIVE_LOGS_PATH=
