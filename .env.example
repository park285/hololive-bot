# ============================================
# Hololive Bot Environment Variables (.env.example)
# ============================================
# 이 파일을 .env로 복사하고 실제 값을 입력하세요.
# 모든 시크릿은 placeholder로 제공되며 운영 전 반드시 변경해야 합니다.

# ============================================
# PostgreSQL (필수)
# ============================================
DB_PASSWORD=
POSTGRES_ADMIN_USER=postgres_admin
HOLOLIVE_DB_USER=hololive_runtime
HOLOLIVE_MIGRATOR_USER=hololive_migrator
HOLOLIVE_SCRAPER_USER=hololive_scraper
HOLOLIVE_SCRAPER_PASSWORD=
# 역할별 전용 비밀번호(비우면 DB_PASSWORD로 폴백). 기존 DB에 적용하려면 ALTER ROLE 필요.
HOLOLIVE_DB_PASSWORD=
HOLOLIVE_MIGRATOR_PASSWORD=

# ============================================
# Valkey (Redis protocol) - Cache
# ============================================
CACHE_HOST=localhost
CACHE_PORT=6379
# admin-dashboard Redis URL에도 사용되므로 URL-safe hex 값을 권장합니다.
CACHE_PASSWORD=
# Tailnet publish는 docker-compose.live-compat.yml overlay를 명시적으로 사용할 때만 주입하세요.
VALKEY_PORT_BIND_IP=
# CACHE_SOCKET_PATH=/var/run/valkey/valkey-cache.sock

# ============================================
# Hololive API Authentication
# ============================================
API_SECRET_KEY=
# hololive-api admin plane /api/auth/* 허용 CIDR 목록 (production 필수, 콤마 구분)
ADMIN_ALLOWED_IPS=172.16.0.0/12,127.0.0.1/32

# ============================================
# Iris (Kakao Bot)
# ============================================
IRIS_BASE_URL=
IRIS_TRANSPORT=h3
IRIS_H3_CA_CERT_FILE=/run/hololive-bot/certs/iris-ca.pem
IRIS_H3_SERVER_NAME=
IRIS_WEBHOOK_TOKEN=
# Iris webhook HMAC은 필수이며 false로 설정하면 startup validation에서 거부된다.
IRIS_WEBHOOK_REQUIRE_HMAC=true
IRIS_BOT_TOKEN=
HOLOLIVE_HTTP_TRANSPORTS=h3
HOLOLIVE_H3_ADDR=:30001
HOLOLIVE_H3_CERT_FILE=/run/hololive-bot/certs/hololive-h3.crt
HOLOLIVE_H3_KEY_FILE=/run/hololive-bot/certs/hololive-h3.key
HOLOLIVE_INTERNAL_H3_CA_CERT_FILE=/run/hololive-bot/certs/hololive-h3.crt
HOLOLIVE_INTERNAL_H3_SERVER_NAME=127.0.0.1
HOLOLIVE_ADMIN_API_HTTP_TRANSPORTS=h3
HOLOLIVE_ALARM_WORKER_HTTP_TRANSPORTS=h3
HOLOLIVE_YOUTUBE_COLLECTOR_HTTP_TRANSPORTS=h3
HOLOLIVE_LLM_SCHEDULER_HTTP_TRANSPORTS=h3
HOLOLIVE_BOT_PORT_BIND_IP=
ADMIN_DASHBOARD_PORT_BIND_IP=
# 운영상 동일 값을 사용할 수는 있지만 변수는 분리해서 유지하세요.
# compose 배포는 기본값 없이 이 세 값을 명시 주입해야 합니다.

# ============================================
# Holodex API Keys (로테이션 풀)
# ============================================
HOLODEX_API_KEY_1=your_holodex_key_1
HOLODEX_API_KEY_2=your_holodex_key_2
HOLODEX_API_KEY_3=your_holodex_key_3
HOLODEX_API_KEY_4=your_holodex_key_4
HOLODEX_API_KEY_5=your_holodex_key_5

# ============================================
# Official Schedule API (upcoming/channel fallback only)
# ============================================
# API-only source. HTML source mode와 HTML fallback은 지원하지 않습니다.
OFFICIAL_SCHEDULE_BASE_URL=https://schedule.hololive.tv
OFFICIAL_SCHEDULE_TIMEOUT_SECONDS=15
OFFICIAL_SCHEDULE_CACHE_EXPIRY_SECONDS=1800
OFFICIAL_SCHEDULE_PAGE_CACHE_TTL_SECONDS=15
MAX_RESPONSE_BODY_BYTES=2097152

# ============================================
# YouTube
# ============================================
YOUTUBE_ENABLE_QUOTA_BUILDING=true
# Community 알림은 youtube-collector AP fleet(기본 compose up의 c) + hololive-api YouTube plane consumer가 모두 필요합니다.
# collector POSTGRES_PASSWORD는 HOLOLIVE_SCRAPER_PASSWORD를 사용합니다.
YOUTUBE_COLLECTOR_TOTAL_WORKERS=4
YOUTUBE_COLLECTOR_QUEUE_CAPACITY=16
YOUTUBE_COLLECTOR_ACQUISITION_BATCH=16
YOUTUBE_COLLECTOR_ACQUISITION_CADENCE_MS=1000
YOUTUBE_COLLECTOR_LEASE_TTL_SECONDS=60
YOUTUBE_COLLECTOR_RENEW_INTERVAL_SECONDS=20
YOUTUBE_COLLECTOR_NORMALIZATION_BUDGET_SECONDS=5
YOUTUBE_COLLECTOR_PUBLISH_BUDGET_SECONDS=5
YOUTUBE_COLLECTOR_RETRY_MIN_SECONDS=30
YOUTUBE_COLLECTOR_RETRY_MAX_SECONDS=300
YOUTUBE_COLLECTOR_RELEASE_JITTER_MIN_MS=100
YOUTUBE_COLLECTOR_RELEASE_JITTER_MAX_MS=1000
YOUTUBE_COLLECTOR_HOLODEX_MAX_INFLIGHT=4
YOUTUBE_COLLECTOR_OFFICIAL_MAX_INFLIGHT=4
YOUTUBE_COLLECTOR_YOUTUBEJS_MAX_INFLIGHT=4
YOUTUBE_COLLECTOR_YOUTUBEJS_TIMEOUT_SECONDS=30
YOUTUBE_COLLECTOR_MAX_PAGES=1
YOUTUBE_COLLECTOR_MAX_AGGREGATE_BYTES=1048576
YOUTUBE_COLLECTOR_REQUEST_INTERVAL_SECONDS=2

# ============================================
# CLIProxy LLM (행사 요약 + 멤버뉴스)
# ============================================
CLIPROXY_ENABLED=true
CLIPROXY_BASE_URL=http://host.docker.internal:8787/v1
CLIPROXY_API_KEY=your_cliproxy_api_key
CLIPROXY_MODEL=gpt-5.4
CLIPROXY_REASONING_EFFORT=high

# ============================================
# YouTube collector / admin PhotoSync
# ============================================
YOUTUBE_INGESTION_ENABLED=true
YOUTUBE_PRODUCER_REQUEST_INTERVAL_SECONDS=2
# hololive-api admin plane default. Collector compose pins PHOTO_SYNC_ENABLED=false.
PHOTO_SYNC_ENABLED=true
# 관측 윈도우 식별용 cutover 타임스탬프(RFC3339). 라우팅에는 영향을 주지 않습니다.
YOUTUBE_COMMUNITY_SHORTS_BIGBANG_CUTOVER_AT=
SCRAPER_PROXY_ENABLED=false
SCRAPER_PROXY_URL=
SCRAPER_SCHEDULER_WORKER_COUNT=2
SCRAPER_POLL_VIDEOS_INTERVAL_SECONDS=300
SCRAPER_POLL_SHORTS_INTERVAL_SECONDS=120
SCRAPER_POLL_COMMUNITY_INTERVAL_SECONDS=120
SCRAPER_POLL_STATS_INTERVAL_SECONDS=21600
SCRAPER_POLL_LIVE_INTERVAL_SECONDS=300
SCRAPER_BACKFILL_ENABLED=false
SCRAPER_BACKFILL_SHORTS_ENABLED=true
SCRAPER_BACKFILL_SHORTS_INTERVAL_SECONDS=300
SCRAPER_BACKFILL_LIVE_ENABLED=true
SCRAPER_BACKFILL_LIVE_INTERVAL_SECONDS=180
SCRAPER_BACKFILL_TARGET_GROUP=notification

# ============================================
# Alarm / Twitch
# ============================================
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ============================================
# Docker Helper Images
# ============================================
DOCKER_SOCKET_PROXY_IMAGE=tecnativa/docker-socket-proxy@sha256:1f3a6f303320723d199d2316a3e82b2e2685d86c275d5e3deeaf182573b47476
DEUNHEALTH_IMAGE=qmcgaw/deunhealth@sha256:db1e4fcd3aceeb0da34a83f7a8a5432df586e6d0388ddb6ad8dd7b479e4aa25d

# ============================================
# Logging
# ============================================
LOG_LEVEL=info
# compose 운영 기본값:
# - application stdout/stderr = SSOT (`docker compose logs`)
# - file mirror = /home/kapu/gemini/hololive-bot/logs/*.log
# - compressed backups = /home/kapu/gemini/hololive-bot/logs/archive/*.gz
# 아래 값은 file mirror 로테이션 정책 기본값입니다.
LOG_MAX_SIZE_MB=5
LOG_MAX_BACKUPS=5
LOG_MAX_AGE_DAYS=30
LOG_COMPRESS=true
# runtime environment (`APP_ENV`) only; legacy `OTEL_ENVIRONMENT` is removed.
APP_ENV=production
# 보조 로그 파일은 기본 비활성입니다.
# ENABLE_LOG_MIRROR=1       # logs/mirror 사용 시에만
# ENABLE_LOG_AUX_FILES=1    # logs/backfill, logs/canary, logs/cron 사용 시에만
# pure stdout-only가 필요할 때만 LOG_DIR를 직접 override 하세요.
# LOG_DIR=logs

# ============================================
# Admin Dashboard (secrets moved to env_file)
# ============================================
# ADMIN_PASS_HASH / SESSION_SECRET / VALKEY_URL / HOLO_BOT_API_KEY 는
# ${ADMIN_DASHBOARD_ENV_FILE:-/run/hololive-bot/admin-dashboard.env} 파일에서 로드된다.
ADMIN_DASHBOARD_ENV_FILE=

# live-compat 오버레이 사용 시 필수: 호스트 로그 디렉터리 절대경로
LIVE_LOGS_PATH=
